# Copy to backend/.env and fill what you need.

# OpenAI key drives the negotiation-script generation.
# If unset, the app falls back to a deterministic rule-based script.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: token for IDFM PRIM (real-time transit). Free at https://prim.iledefrance-mobilites.fr
IDFM_TOKEN=

# Local Redis URL — falls back to in-memory cache if unreachable.
REDIS_URL=redis://localhost:6379/0

# Where the DuckDB file lives.
# DUCKDB_PATH=./data/paris.duckdb

# CORS — comma-separated origins.
CORS_ORIGINS=http://localhost:3000

# Polite User-Agent for outbound HTTP (BAN, listing portals, ADEME).
USER_AGENT=ParisBuyerCopilot/0.1 (+contact@example.com)
